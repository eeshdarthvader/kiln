# Bifrost virtual key for model requests and MCP Catalog access.
MODEL_API_KEY=
# Optional fixed password; otherwise a random 16-character password is generated.
# OPENCODE_PASSWORD=

# Optional runtime model exposed by the AI gateway.
# OPENCODE_MODEL=gpt-6-luna
# OPENCODE_MODELS=gpt-6-luna,gpt-6-sol,gpt-6-astra
# Conservative local token limits; adjust to match your gateway models.
# OPENCODE_CONTEXT_LIMIT=128000
# OPENCODE_OUTPUT_LIMIT=16384
# OpenCode v2 requires HTTP Basic authentication with username opencode.
# Retrieve the generated password through the task UI's Open in OpenCode dialog.
# Browser-facing runtime URL when different from OPENCODE_URL.
# OPENCODE_PUBLIC_URL=https://opencode.example.com
# WORKSPACE_ROOT=/workspace/sawd

# Optional Amazon Bedrock AgentCore gateway MCP (IAM/SigV4 authentication).
# AWS_GATEWAY_URL=https://example.gateway.bedrock-agentcore.eu-central-1.amazonaws.com/mcp
# AWS_REGION=eu-central-1
# Supply AWS credentials through the environment, an IAM role, or a mounted profile.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=

# Optional execution server API authentication token.
# API_TOKEN=

# GitHub Packages token for repository package configuration.
GPR_TOKEN=

# GitHub authentication for repository cloning; use a dedicated credential.
# GH_TOKEN=
# Optional GitHub egress proxy for repository cloning.
GITHUB_EGRESS_PROXY=
# GITHUB_EGRESS_CA=/absolute/container/path/to/custom-ca.crt
