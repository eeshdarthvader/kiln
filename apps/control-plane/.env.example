# Copy to .env. `npm start` and `make start` read it; never commit the copy.

# Repositories to watch, comma separated. Open issues carrying FACTORY_LABEL start a run.
# Leave empty to add issues only from the dashboard.
# FACTORY_REPOS=owner/repo,owner/other-repo
# FACTORY_LABEL=factory
# Seconds between checks; 0 turns automatic checks off.
# FACTORY_POLL_SECONDS=60

# Claude Code credential handed to agent containers. Create one with `claude setup-token`,
# or use an API key instead.
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=
# GitHub token for agents. Defaults to `gh auth token` from this machine's gh login.
# GH_TOKEN=

# Autonomy for repos without .factory/policy.json: L0 approve every step, L1 draft PR (default),
# L2 merge unless critical, L3 merge everything. See the README.
# FACTORY_AUTONOMY=L1

# How many runs work at once, how often one stage may run, and how long a stage may take.
# FACTORY_MAX_RUNS=2
# FACTORY_MAX_STAGE_ATTEMPTS=3
# FACTORY_STAGE_TIMEOUT_MINUTES=45

# Herdr session the factory drives (start it with `make herdr`).
# HERDR_SESSION=factory

# Agent container.
# FACTORY_AGENT_IMAGE=localhost/factory-agent:latest
# FACTORY_AGENT_MODEL=
# Extra `docker run` arguments. On Linux add: --add-host=host.docker.internal:host-gateway
# FACTORY_AGENT_DOCKER_ARGS=

# Where runs, repository clones and worktrees live.
# FACTORY_HOME=/absolute/path          (default: ~/.factory)

# Dashboard and API (127.0.0.1 only). Set a token to require `Authorization: Bearer <token>`.
# FACTORY_PORT=3775
# FACTORY_API_TOKEN=

# Reporting endpoint agents call. Containers must be able to reach FACTORY_MCP_PUBLIC_URL.
# FACTORY_MCP_PORT=3776
# FACTORY_MCP_HOST=127.0.0.1
# FACTORY_MCP_PUBLIC_URL=http://host.docker.internal:3776

# External task trackers (Jira, ...): a JSON file, default ~/.factory/providers.json. See the README.
# FACTORY_TASK_PROVIDERS=/absolute/path/providers.json
# JIRA_API_TOKEN=            (named by "tokenEnv" in providers.json)

# Web terminal in the dashboard: a host shell in each run's worktree. Set off to disable.
# FACTORY_TERMINAL=on
# FACTORY_TERMINAL_SHELL=/bin/zsh
